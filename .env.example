# ==========================================
# PrepPilot OS - Environment Variables Template
# Copy this file to .env and configure your values.
# NOTE: .env is ignored by Git to protect secrets.
# ==========================================

# Gemini AI API Key: Required for Gemini AI API calls.
# Users can configure this via user secrets or in your local .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"

# Google Cloud Platform (GCP) / Firestore Settings (Optional)
VITE_GCP_API_KEY=""
VITE_GCP_PROJECT_ID="preppilot-gcp-db"
VITE_GCP_DATABASE_ID="(default)"
VITE_GCP_REGION="asia-south1"

# Super Admin Credentials
VITE_SUPER_ADMIN_NAME="Administrator"
VITE_SUPER_ADMIN_EMAIL="admin@example.com"
VITE_SUPER_ADMIN_PASSWORD="your-secure-password"
